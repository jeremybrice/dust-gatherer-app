# The single login credential. Server-only — never prefix with NEXT_PUBLIC_.
DUST_GATHERER_PASSPHRASE=change-me

# Signs the session cookie. Rotating this invalidates every existing session.
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me

# Injected automatically by Netlify DB in production. Optional locally —
# the database client is lazy, so the app builds and login works without it.
# NETLIFY_DB_URL=postgres://...
